{
  "autoMemoryEnabled": true,
  "autoCompactEnabled": true,
  "permissions": {
    "allow": [
      "Read(*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(.env*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)"
    ]
  }
}
