    "sql": "SELECT CONCAT(YEAR(data), ' - ', ELT(MONTH(data),'JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ')) AS periodo, SUM(valor) AS total FROM Caminhoes WHERE  data BETWEEN '2019-01-01' AND '2026-10-01' AND serie = 'EXPORTACAO' AND subcategoria = 'SEMILEVES' GROUP BY CONCAT(YEAR(data), ' - ', ELT(MONTH(data),'JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ')) HAVING 1=1;\nSELECT CONCAT(YEAR(data), ' - ', ELT(MONTH(data),'JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ')) AS periodo, SUM(valor) AS total FROM Caminhoes WHERE  data BETWEEN '2019-01-01' AND '2026-10-01' AND serie = 'EXPORTACAO' AND subcategoria = 'LEVES' GROUP BY CONCAT(YEAR(data), ' - ', ELT(MONTH(data),'JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ')) HAVING 1=1;\nSELECT CONCAT(YEAR(data), ' - ', ELT(MONTH(data),'JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ')) AS periodo, SUM(valor) AS total FROM Caminhoes WHERE  data BETWEEN '2019-01-01' AND '2026-10-01' AND serie = 'EXPORTACAO' AND subcategoria = 'MÉDIOS' GROUP BY CONCAT(YEAR(data), ' - ', ELT(MONTH(data),'JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ')) HAVING 1=1;\nSELECT CONCAT(YEAR(data), ' - ', ELT(MONTH(data),'JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ')) AS periodo, SUM(valor) AS total FROM Caminhoes WHERE  data BETWEEN '2019-01-01' AND '2026-10-01' AND serie = 'EXPORTACAO' AND subcategoria = 'SEMIPESADOS' GROUP BY CONCAT(YEAR(data), ' - ', ELT(MONTH(data),'JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ')) HAVING 1=1;\nSELECT CONCAT(YEAR(data), ' - ', ELT(MONTH(data),'JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ')) AS periodo, SUM(valor) AS total FROM Caminhoes WHERE  data BETWEEN '2019-01-01' AND '2026-10-01' AND serie = 'EXPORTACAO' AND subcategoria = 'PESADOS' GROUP BY CONCAT(YEAR(data), ' - ', ELT(MONTH(data),'JAN','FEV',